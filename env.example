# ==============================================================================
# JOB-OPS CLI Environment Configuration Template
# Copy this file to .env and configure your personal API keys
# ==============================================================================

# Google Gemini API Key (Required for AI job evaluation and resume tailoring)
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_DELAY_MS=6500
GEMINI_DAILY_REQUEST_LIMIT=250

# Groq API Key (Optional fallback / fast secondary provider)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MIN_DELAY_MS=2000
GROQ_MAX_OUTPUT_TOKENS=2048

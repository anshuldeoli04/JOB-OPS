DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=jobops
DB_POOL_SIZE=10
PORT=3001
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MIN_DELAY_MS=2000
GROQ_MAX_OUTPUT_TOKENS=2048
# 32-byte hex key generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
# Mandatory 16-byte hex salt generated with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_SALT=your_16_byte_hex_salt_here
# 32-byte hex secret for JWT session token signing: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_byte_hex_session_secret_here
# Backwards-compatibility alias for ENCRYPTION_KEY
# API_KEY_ENCRYPTION_SECRET=your_32_byte_hex_encryption_key_here
